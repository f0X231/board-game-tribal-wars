# Tribal Wars server configuration.
# Copy to server/.env and fill in. Never commit server/.env (it is git-ignored),
# and never expose these keys to /client or prefix them with NEXT_PUBLIC_.

# HTTP port for the Express API
PORT=4000

# Browser origin(s) allowed by CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:3000

# OpenRouter API key (free ":free" models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq API key (free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the advertised model lists (comma-separated). Free-tier
# catalogs change often; set these if a default model gets retired.
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,deepseek/deepseek-r1:free
# GROQ_MODELS=llama-3.3-70b-versatile,mixtral-8x7b-32768

# Optional: max milliseconds per LLM call before falling back to the offline heuristic bot
# LLM_TIMEOUT_MS=10000

# Optional: where completed match telemetry is saved (default: server/data/matches, gitignored)
# MATCH_DATA_DIR=./data/matches
