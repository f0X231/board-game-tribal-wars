# Tribal Wars server configuration.
# Copy to server/.env and fill in. Never commit server/.env (it is git-ignored),
# and never expose these keys to /client or prefix them with NEXT_PUBLIC_.

# HTTP port for the Express API
PORT=4000

# Browser origin(s) allowed by CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:3000

# OpenRouter API key (free ":free" models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq API key (free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# Optional: curated FALLBACK model lists, used only when live discovery of free models fails
# (models are normally discovered live from each provider every 15 minutes; see GET /api/models?refresh=true)
# OPENROUTER_MODELS=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Thinking budget per turn for the 7 research:* search bots (iterative deepening / MCTS).
# 3000-5000 ms gives full strength; every turn is hard-capped at 5000 ms.
BOT_TIME_BUDGET_MS=3500

# Optional: max milliseconds per LLM call before falling back to the offline heuristic bot
# LLM_TIMEOUT_MS=10000

# Optional: where completed match telemetry is saved (default: server/data/matches, gitignored)
# MATCH_DATA_DIR=./data/matches
